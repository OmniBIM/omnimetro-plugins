<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="批量图纸管理"
        Height="680" Width="1240" MinHeight="500" MinWidth="960" MaxHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBgBrush}"
        FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBgBrush" Color="#F5F7FA"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="TextBrush" Color="#1F2937"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#64748B"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#D7E0EA"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#1D4ED8"/>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="Padding" Value="8,5"/><Setter Property="Margin" Value="0,5,0,0"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="Padding" Value="6,4"/><Setter Property="Margin" Value="0,5,0,0"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="Padding" Value="15,8"/><Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="RowBackground" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource SurfaceAltBrush}"/><Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="CanUserResizeRows" Value="False"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <TabControl>
            <TabItem Header="批量修改">
                <Grid Margin="14">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="1. 处理范围" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="条件同时填写时取交集；均为空时处理全部图纸。" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,2"/>
                            <TextBlock Text="图纸编号包含"/><TextBox x:Name="NumberFilterTextBox"/>
                            <TextBlock Text="图纸名称包含" Margin="0,6,0,0"/><TextBox x:Name="NameFilterTextBox"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0">
                            <CheckBox x:Name="ChangeNameCheckBox" Content="2. 批量预填图纸名称" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="勾选后预填表格，仍可逐行修改。" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,2"/>
                            <ComboBox x:Name="NameModeComboBox" SelectedIndex="0"><ComboBoxItem Content="查找并替换"/><ComboBoxItem Content="整体填写"/></ComboBox>
                            <TextBox x:Name="NameFindTextBox" ToolTip="查找内容"/><TextBox x:Name="NameValueTextBox" ToolTip="替换为 / 填写值"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="10,0,0,0">
                            <CheckBox x:Name="ChangeNumberCheckBox" Content="3. 批量预填图纸编号" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="执行时会检查唯一性，支持同批编号互换。" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,2"/>
                            <ComboBox x:Name="NumberModeComboBox" SelectedIndex="0"><ComboBoxItem Content="查找并替换"/><ComboBoxItem Content="整体填写"/></ComboBox>
                            <TextBox x:Name="NumberFindTextBox" ToolTip="查找内容"/><TextBox x:Name="NumberValueTextBox" ToolTip="替换为 / 填写值"/>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,14,0,14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="170"/><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0"><CheckBox x:Name="ChangeParameterCheckBox" Content="4. 修改图纸实例属性" FontSize="16" FontWeight="Bold"/><TextBlock Text="例如：专业、出图阶段、校审人。" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0"/></StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0"><TextBlock Text="参数名称"/><TextBox x:Name="ParameterNameTextBox" ToolTip="参数显示名称必须与 Revit 中完全一致"/></StackPanel>
                        <StackPanel Grid.Column="2" Margin="10,0"><ComboBox x:Name="ParameterModeComboBox" SelectedIndex="1"><ComboBoxItem Content="查找并替换"/><ComboBoxItem Content="整体填写"/></ComboBox><TextBox x:Name="ParameterFindTextBox" ToolTip="查找内容"/></StackPanel>
                        <DockPanel Grid.Column="3" Margin="10,0,0,0">
                            <StackPanel DockPanel.Dock="Left" Width="210"><TextBlock Text="替换为 / 填写值"/><TextBox x:Name="ParameterValueTextBox"/></StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <TextBox x:Name="DrawingListKeywordTextBox" Text="Drawing List" Width="140" ToolTip="Drawing List 名称关键字"/>
                                <Button Content="更新 Drawing List" Click="RefreshDrawingList_Click" Background="{DynamicResource PrimaryBrush}" Foreground="White"/>
                                <Button Content="导出 Excel" Click="ExportExcel_Click"/>
                                <Button Content="导入 Excel" Click="ImportExcel_Click"/>
                                <Button Content="生成预览" Click="Preview_Click"/>
                                <Button Content="执行修改" Click="Execute_Click"/>
                                <Button Content="关闭" Click="Close_Click" Margin="0"/>
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                    <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <DockPanel><TextBlock Text="图纸清单与修改预览" FontSize="16" FontWeight="Bold"/><TextBlock x:Name="SummaryTextBlock" Text="尚未生成预览。" Foreground="{DynamicResource MutedTextBrush}" Margin="16,3,0,0"/></DockPanel>
                            <DataGrid x:Name="PreviewDataGrid" Grid.Row="1" Margin="0,10,0,0" AutoGenerateColumns="False" IsReadOnly="False"><DataGrid.Columns>
                                <DataGridTextColumn Header="原图纸编号" Binding="{Binding OriginalSheetNumber}" Width="135" IsReadOnly="True"/><DataGridTextColumn Header="原图纸名称" Binding="{Binding OriginalSheetName}" Width="190" IsReadOnly="True"/>
                                <DataGridTextColumn Header="目标图纸编号（可编辑）" Binding="{Binding SheetNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="175"/>
                                <DataGridTextColumn Header="目标图纸名称（可编辑）" Binding="{Binding SheetName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="240"/>
                                <DataGridTextColumn Header="属性名称" Binding="{Binding ParameterName}" Width="120" IsReadOnly="True"/><DataGridTextColumn Header="属性原值" Binding="{Binding ParameterSource}" Width="130" IsReadOnly="True"/>
                                <DataGridTextColumn Header="属性目标值" Binding="{Binding ParameterTarget}" Width="130" IsReadOnly="True"/><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="80" IsReadOnly="True"/>
                                <DataGridTextColumn Header="说明" Binding="{Binding Message}" Width="*" IsReadOnly="True"/>
                            </DataGrid.Columns></DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="属性复制">
                <Grid Margin="14">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <DockPanel Grid.ColumnSpan="2" Margin="0,0,0,10">
                        <TextBlock Text="从源图纸复制属性" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="按原始参数类型复制，失败原因显示在目标图纸表中。" Foreground="{DynamicResource MutedTextBrush}" Margin="16,3,0,0"/>
                        <Button Content="复制所选属性" Click="CopyProperties_Click" Background="{DynamicResource PrimaryBrush}" Foreground="White" DockPanel.Dock="Right" Margin="10,0,0,0"/>
                        <Button Content="全不选图纸" Click="ClearTargets_Click" DockPanel.Dock="Right" Margin="10,0,0,0"/>
                        <Button Content="选择全部图纸" Click="SelectAllTargets_Click" DockPanel.Dock="Right" Margin="10,0,0,0"/>
                    </DockPanel>
                    <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,8,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <DockPanel><TextBlock Text="源图纸" VerticalAlignment="Center"/><ComboBox x:Name="SourceSheetComboBox" Width="280" Margin="10,0"/><Button Content="加载全部属性和值" Click="LoadSourceProperties_Click"/><Button Content="全选属性" Click="SelectAllProperties_Click"/><Button Content="全不选" Click="ClearProperties_Click" Margin="0"/></DockPanel>
                        <DataGrid x:Name="PropertyDataGrid" Grid.Row="1" Margin="0,10,0,0" AutoGenerateColumns="False" IsReadOnly="False"><DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="复制" Binding="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="55"/><DataGridTextColumn Header="属性名称" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="源值" Binding="{Binding Value}" Width="150" IsReadOnly="True"/><DataGridTextColumn Header="类型" Binding="{Binding StorageTypeName}" Width="90" IsReadOnly="True"/><DataGridCheckBoxColumn Header="可写" Binding="{Binding IsWritable}" Width="55" IsReadOnly="True"/>
                        </DataGrid.Columns></DataGrid>
                    </Grid>
                    <Grid Grid.Row="1" Grid.Column="1" Margin="8,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="目标图纸（勾选后接收源图纸所选属性）" FontWeight="Bold"/>
                        <DataGrid x:Name="CopyTargetDataGrid" Grid.Row="1" Margin="0,10,0,0" AutoGenerateColumns="False" IsReadOnly="False"><DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="复制到此图纸" Binding="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100"/><DataGridTextColumn Header="图纸编号" Binding="{Binding SheetNumber}" Width="110" IsReadOnly="True"/>
                            <DataGridTextColumn Header="图纸名称" Binding="{Binding SheetName}" Width="160" IsReadOnly="True"/><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="75" IsReadOnly="True"/><DataGridTextColumn Header="说明" Binding="{Binding Message}" Width="*" IsReadOnly="True"/>
                        </DataGrid.Columns></DataGrid>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="执行日志">
                <Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="执行日志" FontSize="16" FontWeight="Bold"/>
                    <TextBox x:Name="LogTextBox" Grid.Row="1" Margin="0,10,0,0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
