<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Revit 2027 → Revit 2020 BIM 迁移平台"
        Height="680" Width="960"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC">
    <Window.Resources>
        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0" Background="#0F172A" CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Revit 2027 → 2020 BIM Migrator" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="跨版本 BIM 数据迁移与原生模型重建平台 (五级降级体系 + 完整验证)" FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="v0.1.0" Foreground="#64748B" VerticalAlignment="Center" FontSize="12"/>
            </Grid>
        </Border>

        <!-- Main Tabs -->
        <TabControl Grid.Row="1" Name="MainTabControl">
            <!-- Tab 1: Project Overview -->
            <TabItem Header="项目概览">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="模型概况与迁移能力估计" FontSize="16" FontWeight="Bold" Foreground="#1E293B"/>
                        <TextBlock Text="基于当前打开的 Revit 2027 模型进行非破坏性静态扫描分析" FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Model Info -->
                        <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="模型对象统计" FontSize="14" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,12"/>
                                <Grid Margin="0,4">
                                    <TextBlock Text="当前项目：" Foreground="#64748B"/>
                                    <TextBlock Name="txtProjectName" Text="Project_A.rvt" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <TextBlock Text="源 Revit 版本：" Foreground="#64748B"/>
                                    <TextBlock Name="txtSourceVersion" Text="Revit 2027 (.NET 10)" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <TextBlock Text="目标 Revit 版本：" Foreground="#64748B"/>
                                    <TextBlock Text="Revit 2020" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#2563EB"/>
                                </Grid>
                                <Separator Margin="0,8"/>
                                <Grid Margin="0,4">
                                    <TextBlock Text="BIM 元素总数：" Foreground="#64748B"/>
                                    <TextBlock Name="txtTotalElements" Text="-" HorizontalAlignment="Right" FontWeight="Bold"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <TextBlock Text="族 (Families)：" Foreground="#64748B"/>
                                    <TextBlock Name="txtTotalFamilies" Text="-" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <TextBlock Text="材质 (Materials)：" Foreground="#64748B"/>
                                    <TextBlock Name="txtTotalMaterials" Text="-" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <TextBlock Text="视图与图纸：" Foreground="#64748B"/>
                                    <TextBlock Name="txtTotalViews" Text="-" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Right: Capability Score -->
                        <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="总体迁移能力预估" FontSize="14" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,12"/>
                                <Grid Margin="0,4">
                                    <TextBlock Text="预计迁移覆盖率：" Foreground="#64748B" FontSize="14"/>
                                    <TextBlock Name="txtCoveragePercent" Text="99.6%" HorizontalAlignment="Right" FontSize="20" FontWeight="Bold" Foreground="#16A34A"/>
                                </Grid>
                                <Separator Margin="0,8"/>
                                <Grid Margin="0,4">
                                    <TextBlock Text="原生重建 (Level 1)：" Foreground="#64748B"/>
                                    <TextBlock Name="txtNativeRatio" Text="92.6%" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <TextBlock Text="族重建 (Level 2)：" Foreground="#64748B"/>
                                    <TextBlock Name="txtFamilyRatio" Text="4.1%" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <TextBlock Text="几何兜底 (Level 3/4)：" Foreground="#64748B"/>
                                    <TextBlock Name="txtGeometryRatio" Text="2.9%" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <TextBlock Text="不支持项 (Level 5)：" Foreground="#64748B"/>
                                    <TextBlock Name="txtUnsupportedRatio" Text="0.4%" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#DC2626"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Name="btnImportPackage" Content="导入并重建模型 (.rvtmig)" Width="190" Background="#0284C7" Margin="0,0,12,0"/>
                        <Button Name="btnScanModel" Content="扫描当前模型" Width="140" Margin="0,0,12,0"/>
                        <Button Name="btnExportPackage" Content="开始导出 .rvtmig" Width="160" Background="#16A34A"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Tab 2: Scan Results DataGrid -->
            <TabItem Header="扫描结果">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="各 BIM 类别迁移可行性评估矩阵" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                    <DataGrid Grid.Row="1" Name="gridScanResults" AutoGenerateColumns="False" IsReadOnly="True" Background="White" BorderBrush="#E2E8F0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="BIM 类别" Binding="{Binding Category}" Width="150"/>
                            <DataGridTextColumn Header="总数量" Binding="{Binding Count}" Width="80"/>
                            <DataGridTextColumn Header="原生重建" Binding="{Binding Native}" Width="80"/>
                            <DataGridTextColumn Header="族重建" Binding="{Binding Family}" Width="80"/>
                            <DataGridTextColumn Header="几何兜底" Binding="{Binding Geometry}" Width="80"/>
                            <DataGridTextColumn Header="不支持" Binding="{Binding Unsupported}" Width="80"/>
                            <DataGridTextColumn Header="风险等级" Binding="{Binding Risk}" Width="80"/>
                            <DataGridTextColumn Header="备注说明" Binding="{Binding Remarks}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Tab 3: Configuration -->
            <TabItem Header="转换配置">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="16">
                    <StackPanel>
                        <TextBlock Text="迁移配置档预设" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <RadioButton Name="rbProfileSafe" Content="安全模式 (Safe - 仅基础几何/跳过高级约束)" Margin="0,0,16,0"/>
                            <RadioButton Name="rbProfileBalanced" Content="平衡模式 (Balanced - 推荐默认)" IsChecked="True" Margin="0,0,16,0"/>
                            <RadioButton Name="rbProfileMaximum" Content="全量模式 (Maximum - 包含全部视图/标注/图纸)"/>
                        </StackPanel>

                        <Separator Margin="0,8,0,16"/>

                        <TextBlock Text="重建设施与组件开关" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
                        <WrapPanel Margin="0,0,0,16">
                            <CheckBox Name="chkNativeRebuild" Content="原生对象重建 (Walls, Floors, Roofs)" IsChecked="True" Width="280" Margin="0,4"/>
                            <CheckBox Name="chkFamilyRebuild" Content="族结构与参数重建 (Loadable Families)" IsChecked="True" Width="280" Margin="0,4"/>
                            <CheckBox Name="chkGeometryFallback" Content="DirectShape / SAT 几何兜底" IsChecked="True" Width="280" Margin="0,4"/>
                            <CheckBox Name="chkMaterials" Content="材质与颜色外观恢复" IsChecked="True" Width="280" Margin="0,4"/>
                            <CheckBox Name="chkParameters" Content="实例/类型参数与共享参数恢复" IsChecked="True" Width="280" Margin="0,4"/>
                            <CheckBox Name="chkDatums" Content="标高与轴网系统 (Levels &amp; Grids)" IsChecked="True" Width="280" Margin="0,4"/>
                            <CheckBox Name="chkViews" Content="视图与视图样板 (Views &amp; Templates)" IsChecked="True" Width="280" Margin="0,4"/>
                            <CheckBox Name="chkSheets" Content="图纸与视口布局 (Sheets &amp; Viewports)" IsChecked="True" Width="280" Margin="0,4"/>
                            <CheckBox Name="chkMEP" Content="机电管线原生重建 (Pipes, Ducts, Trays)" IsChecked="True" Width="280" Margin="0,4"/>
                            <CheckBox Name="chkAnnotations" Content="尺寸标注与标记 (Annotations)" IsChecked="False" Width="280" Margin="0,4"/>
                        </WrapPanel>

                        <Separator Margin="0,8,0,16"/>

                        <TextBlock Text="性能与批处理控制" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="单事务提交批次 (Batch Size):" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Name="txtBatchSize" Text="1000" Padding="4"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 4: Real-time Progress -->
            <TabItem Header="转换进度">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Name="lblCurrentPhase" Text="当前阶段：等待开始" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>
                    <ProgressBar Grid.Row="1" Name="progOverall" Height="24" Minimum="0" Maximum="100" Value="0" Margin="0,0,0,8"/>
                    <TextBlock Grid.Row="2" Name="lblProgressDetail" Text="0 / 0 元素处理完成 (0%)" Foreground="#64748B" Margin="0,0,0,16"/>

                    <!-- Real-time Status Card -->
                    <Border Grid.Row="3" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel>
                            <TextBlock Text="实时处理日志" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,8"/>
                            <ScrollViewer Height="220" VerticalScrollBarVisibility="Auto">
                                <TextBlock Name="txtLiveStatus" Text="系统就绪。" FontFamily="Consolas" FontSize="12" Foreground="#475569" TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Name="btnCancel" Content="取消操作" Background="#DC2626" Width="120"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Tab 5: Logs -->
            <TabItem Header="日志">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBox Grid.Row="0" Name="txtLogWindow" IsReadOnly="True" FontFamily="Consolas" FontSize="12" Background="#1E293B" Foreground="#F8FAFC" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Name="btnExportLog" Content="导出日志文件" Width="140"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Tab 6: Validation -->
            <TabItem Header="验证">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="模型保真度与几何校验报告" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>

                    <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel>
                            <Grid Margin="0,6">
                                <TextBlock Text="源模型元素总数：" Foreground="#64748B"/>
                                <TextBlock Name="valSourceTotal" Text="-" HorizontalAlignment="Right" FontWeight="Bold"/>
                            </Grid>
                            <Grid Margin="0,6">
                                <TextBlock Text="目标模型重建总数：" Foreground="#64748B"/>
                                <TextBlock Name="valTargetTotal" Text="-" HorizontalAlignment="Right" FontWeight="Bold"/>
                            </Grid>
                            <Separator Margin="0,10"/>
                            <Grid Margin="0,6">
                                <TextBlock Text="几何体积与包围盒匹配率：" Foreground="#64748B"/>
                                <TextBlock Name="valGeomMatch" Text="98.8%" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#16A34A"/>
                            </Grid>
                            <Grid Margin="0,6">
                                <TextBlock Text="参数名称与数值匹配率：" Foreground="#64748B"/>
                                <TextBlock Name="valParamMatch" Text="97.5%" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#16A34A"/>
                            </Grid>
                            <Grid Margin="0,6">
                                <TextBlock Text="材质与外观匹配率：" Foreground="#64748B"/>
                                <TextBlock Name="valMatMatch" Text="98.2%" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#16A34A"/>
                            </Grid>
                            <Grid Margin="0,6">
                                <TextBlock Text="族定义与类型匹配率：" Foreground="#64748B"/>
                                <TextBlock Name="valFamMatch" Text="96.0%" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#16A34A"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Name="btnExportErrors" Content="导出失败清单 (CSV)" Width="160" Background="#D97706" Margin="0,0,12,0"/>
                        <Button Name="btnExportHtmlReport" Content="导出完整 HTML 报告" Width="180" Background="#16A34A"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="2" Background="#E2E8F0" CornerRadius="4" Padding="10,6" Margin="0,8,0,0">
            <Grid>
                <TextBlock Name="txtStatusFooter" Text="就绪 | 请点击 [扫描当前模型] 进行迁移评估" FontSize="12" Foreground="#475569"/>
                <TextBlock Text="RVT2020 Migrator Engine" HorizontalAlignment="Right" FontSize="11" Foreground="#94A3B8"/>
            </Grid>
        </Border>
    </Grid>
</Window>
