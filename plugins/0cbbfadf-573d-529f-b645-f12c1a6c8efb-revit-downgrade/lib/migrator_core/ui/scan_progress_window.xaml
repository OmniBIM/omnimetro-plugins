<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="模型扫描进度 - Revit 2027"
        Height="320" Width="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Background="#F8FAFC">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Stage Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Name="txtStage" Text="正在准备扫描模型..." FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
            <TextBlock Name="txtDetail" Text="初始化扫描器与文档连接..." FontSize="13" Foreground="#475569" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Progress Bar -->
        <ProgressBar Grid.Row="1" Name="progressBar" Height="22" Minimum="0" Maximum="100" Value="0" Margin="0,0,0,10" Foreground="#2563EB"/>

        <!-- Progress Indicators -->
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Name="txtPercent" Text="0.0%" FontSize="14" FontWeight="Bold" Foreground="#2563EB"/>
            <TextBlock Grid.Column="1" Name="txtSpeed" Text="扫描速度: 0 个/秒" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="2" Name="txtElapsed" Text="已耗时: 0.0s" FontSize="12" Foreground="#64748B"/>
        </Grid>

        <!-- Live Current Item Box -->
        <Border Grid.Row="3" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="实时扫描构件 / 状态：" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                <TextBlock Grid.Row="1" Name="txtCurrentItem" Text="正在启动扫描引擎..." FontFamily="Consolas" FontSize="12" Foreground="#334155" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>

        <!-- Action / Cancel Button -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Name="btnCancelScan" Content="取消扫描" Width="100" Height="32" Background="#EF4444" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
