<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TKbox 视图助手"
        Height="680"
        Width="1180"
        MinHeight="500"
        MinWidth="960"
        MaxHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#EEF3F8">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBgBrush" Color="#EEF3F8"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="PanelSoftBrush" Color="#F7FAFC"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#D7E2EC"/>
        <SolidColorBrush x:Key="InkBrush" Color="#17324D"/>
        <SolidColorBrush x:Key="TextBrush" Color="#334155"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#64748B"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#1D4ED8"/>
        <SolidColorBrush x:Key="CyanBrush" Color="#0F766E"/>
        <SolidColorBrush x:Key="AmberBrush" Color="#B45309"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="22"
                Padding="24"
                Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="TKbox 视图助手 v4.2"
                               FontSize="34"
                               FontWeight="Bold"
                               Foreground="{DynamicResource InkBrush}"/>
                    <TextBlock Text="把常用视图整理工作集中到一个入口：首页说明每个功能怎么用、什么时候用、运行前要准备什么。"
                               Margin="0,10,0,0"
                               FontSize="16"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="建议顺序：先看说明，再按当前任务进入对应模块。Esc 或取消会直接退出当前操作，不会强制写入。"
                               Margin="0,12,0,0"
                               Foreground="{DynamicResource MutedBrush}"
                               FontSize="14"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="{DynamicResource PanelSoftBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="18"
                        Margin="18,0,0,0">
                    <StackPanel>
                        <TextBlock Text="首页用途"
                                   FontWeight="Bold"
                                   FontSize="18"
                                   Foreground="{DynamicResource InkBrush}"/>
                        <TextBlock Text="1. 选择功能前先确认当前处于平面、剖面还是图纸。"
                                   Margin="0,12,0,0"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="2. 直接查看每个模块的运行条件，避免点进去后才发现视图类型不对。"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="3. 保留现有功能逻辑，入口更清晰，不改变你的工作习惯。"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <TextBlock Grid.Row="1"
                   Text="功能导航"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="{DynamicResource InkBrush}"
                   Margin="6,0,0,14"/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    CornerRadius="22"
                    Padding="20"
                    Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="1. 视图裁切"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryBrush}"/>
                    <Button Grid.Row="1"
                            Background="{DynamicResource PrimaryBrush}"
                            Content="立即运行视图裁切"
                            Margin="0,16,0,0"
                            Click="RunCrop_Click"/>
                    <TextBlock Grid.Row="2"
                               Text="适合在当前平面或剖面里，快速框出一个局部区域，生成新视图并立即归类。"
                               Margin="0,16,0,0"
                               FontSize="15"
                               TextWrapping="Wrap"/>
                    <Border Grid.Row="3"
                            Background="#EEF4FF"
                            CornerRadius="14"
                            Padding="12"
                            Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="使用步骤" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"/>
                            <TextBlock Text="1. 在平面或剖面中运行。"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="2. 鼠标框选要裁切的范围。"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="3. 输入新视图名称。"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="4. 选择已有分类，或新建分类后自动归位。"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Row="4" Margin="0,16,0,0">
                        <TextBlock Text="运行条件" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"/>
                        <TextBlock Text="当前视图不能是三维视图。"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="常见用途：从总图快速拆出局部设备布置图、节点定位图。"
                                   Margin="0,8,0,0"
                                   Foreground="{DynamicResource MutedBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    CornerRadius="22"
                    Padding="20"
                    Margin="12,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="2. 图纸排版"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{DynamicResource CyanBrush}"/>
                    <Button Grid.Row="1"
                            Background="{DynamicResource CyanBrush}"
                            Content="立即运行图纸排版"
                            Margin="0,16,0,0"
                            Click="RunLayout_Click"/>
                    <TextBlock Grid.Row="2"
                               Text="适合在图纸视图里批量把多个平面或剖面视图快速放到图纸上，减少手动逐个上图。"
                               Margin="0,16,0,0"
                               FontSize="15"
                               TextWrapping="Wrap"/>
                    <Border Grid.Row="3"
                            Background="#ECFEFF"
                            CornerRadius="14"
                            Padding="12"
                            Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="使用步骤" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"/>
                            <TextBlock Text="1. 先切换到目标图纸视图。"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="2. 多选需要上图的平面或剖面视图。"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="3. 工具会按网格自动排列视口。"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Row="4" Margin="0,16,0,0">
                        <TextBlock Text="运行条件" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"/>
                        <TextBlock Text="当前必须处于图纸视图。"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="常见用途：同一专业多张设备布置图、分区图、剖面图快速上图。"
                                   Margin="0,8,0,0"
                                   Foreground="{DynamicResource MutedBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    CornerRadius="22"
                    Padding="20"
                    Margin="12,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="3. 高级树管理器"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AmberBrush}"/>
                    <Button Grid.Row="1"
                            Background="{DynamicResource AmberBrush}"
                            Content="立即打开树管理器"
                            Margin="0,16,0,0"
                            Click="RunTree_Click"/>
                    <TextBlock Grid.Row="2"
                               Text="适合做全项目视图整理。可以先拖拽预览，再统一保存，不用边改边冒风险。"
                               Margin="0,16,0,0"
                               FontSize="15"
                               TextWrapping="Wrap"/>
                    <Border Grid.Row="3"
                            Background="#FFF7ED"
                            CornerRadius="14"
                            Padding="12"
                            Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="使用步骤" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"/>
                            <TextBlock Text="1. 打开后查看完整视图树。"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="2. 将视图节点拖到目标专业或分类下。"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="3. 先观察预览提示，再统一保存。"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="4. 如果不满意，可先点击“还原预览”。"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Row="4" Margin="0,16,0,0">
                        <TextBlock Text="运行条件" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"/>
                        <TextBlock Text="适用于需要批量重组视图分类、专业归属的场景。"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="常见用途：项目交付前统一整理视图树、修正分类结构。"
                                   Margin="0,8,0,0"
                                   Foreground="{DynamicResource MutedBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="18"
                Padding="18"
                Margin="0,18,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="补充说明"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{DynamicResource InkBrush}"/>
                    <TextBlock Text="• 视图裁切和图纸排版都会直接作用于当前文档，请先确认当前视图是否正确。"
                               Margin="0,10,0,0"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="• 高级树管理器采用“预览后提交”，只有点击保存时才真正写入。"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="• 如果只是想知道怎么用，不必马上运行任何模块；可以先看完本页说明。"
                               Margin="0,6,0,0"
                               Foreground="{DynamicResource MutedBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Height="46"
                        VerticalAlignment="Bottom"
                        Background="#475569"
                        Content="关闭首页"
                        Margin="18,0,0,0"
                        Click="CloseWindow_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
