<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="项目基点批量管理器" Height="600" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBgBrush}">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBgBrush" Color="#F5F6F7"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F7FAFC"/>
        <SolidColorBrush x:Key="TextBrush" Color="#1F2937"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#718096"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#3182CE"/>
        <SolidColorBrush x:Key="SecondaryBrush" Color="#4A5568"/>
        <SolidColorBrush x:Key="TertiaryBrush" Color="#718096"/>
        <SolidColorBrush x:Key="ActionBrush" Color="#805AD5"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#38A169"/>
        <SolidColorBrush x:Key="RowSuccessBrush" Color="#E6FFFA"/>
        <SolidColorBrush x:Key="RowErrorBrush" Color="#FFF5F5"/>
        <SolidColorBrush x:Key="RowBusyBrush" Color="#EBF8FF"/>
        <SolidColorBrush x:Key="MismatchBrush" Color="#FED7D7"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="RowBackground" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource SurfaceAltBrush}"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <!-- 状态背景转换器 -->
        <Style x:Key="RowStyle" TargetType="DataGridRow">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="修改成功">
                    <Setter Property="Background" Value="{DynamicResource RowSuccessBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="失败">
                    <Setter Property="Background" Value="{DynamicResource RowErrorBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="提取中">
                    <Setter Property="Background" Value="{DynamicResource RowBusyBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 数据比对变色逻辑 -->
        <Style x:Key="CompareStyle" TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMismatch}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource MismatchBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部操作栏 -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
            <Button Content="选择 Revit 文件" Click="SelectFiles_Click" Padding="15,5" Margin="0,0,10,0" Background="{DynamicResource PrimaryBrush}" Foreground="White" BorderThickness="0"/>
            <Button Content="批量填充真实数据" Click="BatchFill_Click" Padding="15,5" Margin="0,0,10,0" Background="{DynamicResource SecondaryBrush}" Foreground="White" BorderThickness="0"/>
            <Button Content="填充当前数据" Click="FillCurrent_Click" Padding="15,5" Margin="0,0,10,0" Background="{DynamicResource TertiaryBrush}" Foreground="White" BorderThickness="0"/>
            <TextBlock Text="* 修改操作会直接保存文件，请确保文件未被占用" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"/>
        </StackPanel>

        <!-- 数据表格 -->
        <DataGrid x:Name="DataGridFiles" Grid.Row="1" 
                  AutoGenerateColumns="False" 
                  CanUserAddRows="False" 
                  SelectionMode="Extended"
                  RowStyle="{StaticResource RowStyle}"
                  Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                  AlternatingRowBackground="{DynamicResource SurfaceAltBrush}">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="选择" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridTextColumn Header="文件名" Binding="{Binding FileName}" IsReadOnly="True" Width="150"/>
                <DataGridTextColumn Header="状态" Binding="{Binding Status}" IsReadOnly="True" Width="80"/>
                
                <!-- 真实数据 (可编辑) -->
                <DataGridTextColumn Header="真实 N/S" Binding="{Binding TargetNS, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                <DataGridTextColumn Header="真实 E/W" Binding="{Binding TargetEW, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                <DataGridTextColumn Header="真实 高程" Binding="{Binding TargetElev, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                <DataGridTextColumn Header="真实 角度" Binding="{Binding TargetAngle, UpdateSourceTrigger=PropertyChanged}" Width="80"/>

                <!-- 提取数据 (只读) -->
                <DataGridTextColumn Header="当前 N/S" Binding="{Binding CurrentNS}" IsReadOnly="True" Width="80" CellStyle="{StaticResource CompareStyle}"/>
                <DataGridTextColumn Header="当前 E/W" Binding="{Binding CurrentEW}" IsReadOnly="True" Width="80" CellStyle="{StaticResource CompareStyle}"/>
                <DataGridTextColumn Header="当前 高程" Binding="{Binding CurrentElev}" IsReadOnly="True" Width="80" CellStyle="{StaticResource CompareStyle}"/>
                <DataGridTextColumn Header="当前 角度" Binding="{Binding CurrentAngle}" IsReadOnly="True" Width="80" CellStyle="{StaticResource CompareStyle}"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 底部按钮 -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="2" Margin="0,15,0,0">
            <Button Content="提取所选数据" Click="ExtractData_Click" Padding="25,8" Margin="0,0,15,0" Background="{DynamicResource ActionBrush}" Foreground="White" BorderThickness="0"/>
            <Button Content="开始批量修改" Click="RunBatch_Click" Padding="25,8" Background="{DynamicResource SuccessBrush}" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
