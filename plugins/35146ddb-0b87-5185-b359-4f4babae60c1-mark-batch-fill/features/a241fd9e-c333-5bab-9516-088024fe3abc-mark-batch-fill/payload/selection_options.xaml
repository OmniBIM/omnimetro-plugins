<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="框选区域编号设置"
        Height="660"
        Width="900"
        MinHeight="620"
        MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBgBrush}"
        FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBgBrush" Color="#F5F7FA"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="TextBrush" Color="#1F2937"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#64748B"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#D7E0EA"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#1D4ED8"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#15803D"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#B45309"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#B91C1C"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="MinHeight" Value="92"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="框选区域编号设置" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="确认后只生成预览；回到主窗口后再点击批量写入。"
                       Foreground="{DynamicResource MutedTextBrush}"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,12">
                    <TextBlock Text="类别关键字"/>
                    <TextBox x:Name="CategoryKeywordTextBox" TextChanged="FilterInput_Changed"/>
                    <TextBlock Text="类别选择（可多选）" Margin="0,8,0,0"/>
                    <ListBox x:Name="CategoryListBox"
                             SelectionMode="Extended"
                             SelectionChanged="FilterSelection_Changed"/>
                    <TextBlock x:Name="CountTextBlock"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,10,12">
                    <TextBlock Text="族名关键字"/>
                    <TextBox x:Name="FamilyKeywordTextBox" TextChanged="FilterInput_Changed"/>
                    <TextBlock Text="族名选择（可多选）" Margin="0,8,0,0"/>
                    <ListBox x:Name="FamilyListBox"
                             SelectionMode="Extended"
                             SelectionChanged="FilterSelection_Changed"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2" Margin="10,0,0,12">
                    <TextBlock Text="类型名关键字"/>
                    <TextBox x:Name="TypeKeywordTextBox" TextChanged="FilterInput_Changed"/>
                    <TextBlock Text="类型名选择（可多选）" Margin="0,8,0,0"/>
                    <ListBox x:Name="TypeListBox"
                             SelectionMode="Extended"
                             SelectionChanged="FilterSelection_Changed"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,12">
                    <TextBlock Text="站点段"/>
                    <TextBox x:Name="StationTextBox" TextChanged="AnyInput_Changed"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,10,12">
                    <TextBlock Text="房间段"/>
                    <TextBox x:Name="RoomTextBox" TextChanged="AnyInput_Changed"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="10,0,0,12">
                    <TextBlock Text="专业段"/>
                    <TextBox x:Name="DisciplineTextBox" TextChanged="AnyInput_Changed"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,12">
                    <TextBlock Text="设备段"/>
                    <TextBox x:Name="DeviceTextBox" TextChanged="AnyInput_Changed"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="1" Margin="10,0,10,12">
                    <TextBlock Text="起始编号"/>
                    <TextBox x:Name="StartNumberTextBox" TextChanged="AnyInput_Changed"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="2" Margin="10,0,0,12">
                    <TextBlock Text="编号位数"/>
                    <TextBox x:Name="SequenceWidthTextBox" TextChanged="AnyInput_Changed"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10"
                Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Text="编码示例" FontWeight="SemiBold"/>
                <TextBlock x:Name="SampleTextBlock" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="3" LastChildFill="False" Margin="0,14,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="确认生成预览" Click="Confirm_Click" ToolTip="按当前筛选条件和编码规则生成主窗口预览。"/>
                <Button Content="取消" Click="Cancel_Click" ToolTip="放弃本次框选编号设置并返回主窗口。" Margin="0"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
