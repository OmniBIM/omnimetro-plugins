<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mark编码批量填写"
        Height="680"
        Width="1200"
        MinHeight="500"
        MinWidth="900"
        MaxHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBgBrush}"
        FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBgBrush" Color="#F5F7FA"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="TextBrush" Color="#1F2937"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#64748B"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#D7E0EA"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#1D4ED8"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#15803D"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#B45309"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#B91C1C"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="RowBackground" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource SurfaceAltBrush}"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Extended"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="160"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="1.3*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="16"
                    Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="扫描与筛选" FontSize="18" FontWeight="Bold"/>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,12,10,0">
                        <TextBlock Text="目标参数名"/>
                        <TextBox x:Name="TargetParameterTextBox" Text="Mark"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,12,0,0">
                        <TextBlock Text="类别筛选"/>
                        <ComboBox x:Name="CategoryComboBox"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,12,10,0">
                        <TextBlock Text="族名关键字"/>
                        <TextBox x:Name="FamilyFilterTextBox"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="10,12,0,0">
                        <TextBlock Text="类型名关键字"/>
                        <TextBox x:Name="TypeFilterTextBox"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="扫描目标实例" Click="Scan_Click" ToolTip="扫描模型中包含目标参数的族实例。"/>
                        <Button Content="应用筛选" Click="ApplyFilter_Click" ToolTip="按当前类别、族名、类型名条件刷新列表。"/>
                        <Button Content="清空筛选" Click="ClearFilter_Click" ToolTip="清除筛选条件，显示全部已扫描实例。" Margin="0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="编码规则" FontSize="18" FontWeight="Bold"/>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,12,10,0">
                        <TextBlock Text="站点段"/>
                        <TextBox x:Name="StationCodeTextBox" Text="BB05"/>
                        <TextBlock Text="房间段" Margin="0,10,0,0"/>
                        <TextBox x:Name="RoomCodeTextBox"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,12,10,0">
                        <TextBlock Text="专业段"/>
                        <TextBox x:Name="DisciplineCodeTextBox" Text="COM"/>
                        <TextBlock Text="序号位数" Margin="0,10,0,0"/>
                        <TextBox x:Name="SequenceWidthTextBox" Text="4"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="10,12,0,0">
                        <TextBlock Text="类型段来源"/>
                        <ComboBox x:Name="TypeSourceComboBox" SelectedIndex="0">
                            <ComboBoxItem Content="类型名称"/>
                            <ComboBoxItem Content="族名称"/>
                            <ComboBoxItem Content="类型参数"/>
                            <ComboBoxItem Content="实例参数"/>
                            <ComboBoxItem Content="固定文本"/>
                        </ComboBox>
                        <TextBlock Text="类型段参数名 / 固定值" Margin="0,10,0,0"/>
                        <TextBox x:Name="TypeSourceValueTextBox"/>
                    </StackPanel>

                    <TextBlock Grid.Row="2"
                               Grid.ColumnSpan="3"
                               Margin="0,14,0,0"
                               Text="当前模式：暂不读取房间号，按族类别分别从左到右、从上到下生成纯序号，默认从 0001 开始。"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextWrapping="Wrap"/>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="16"
                Margin="0,0,0,14">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Content="预览编码" Click="Preview_Click" ToolTip="按当前列表和规则生成待写入预览。"/>
                    <Button Content="框选区域重编号" Click="RenumberSelection_Click" ToolTip="框选模型区域，再按筛选和多段规则重新编号。"/>
                    <Button Content="批量写入" Click="Write_Click" ToolTip="将状态为待写入的预览值写入目标参数。"/>
                    <Button Content="关闭" Click="Close_Click" ToolTip="关闭当前工具窗口。" Margin="0"/>
                </StackPanel>
                <TextBlock x:Name="SummaryTextBlock"
                           DockPanel.Dock="Right"
                           VerticalAlignment="Center"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Text="请先扫描目标实例。"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="14"
                Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="预览列表"
                               DockPanel.Dock="Left"
                               FontSize="18"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="删除选中记录" Click="DeletePreviewRows_Click" ToolTip="从预览列表移除选中行，不修改模型参数。"/>
                        <Button Content="清空预览列表" Click="ClearPreview_Click" ToolTip="清空全部预览记录，不修改模型参数。" Margin="0"/>
                    </StackPanel>
                </DockPanel>
                <DataGrid x:Name="ItemsDataGrid"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          KeyDown="ItemsDataGrid_KeyDown"
                          MouseDoubleClick="ItemsDataGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="类别" Binding="{Binding Category}" Width="120"/>
                        <DataGridTextColumn Header="族名" Binding="{Binding FamilyName}" Width="180"/>
                        <DataGridTextColumn Header="类型名" Binding="{Binding TypeName}" Width="180"/>
                        <DataGridTextColumn Header="当前值" Binding="{Binding CurrentValue}" Width="180"/>
                        <DataGridTextColumn Header="预览值" Binding="{Binding PreviewValue}" Width="220"/>
                        <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="100"/>
                        <DataGridTextColumn Header="说明" Binding="{Binding Message}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Border Grid.Row="3"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="执行日志" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                <TextBox x:Name="LogTextBox"
                         Grid.Row="1"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         AcceptsReturn="True"/>
            </Grid>
        </Border>
    </Grid>
</Window>
